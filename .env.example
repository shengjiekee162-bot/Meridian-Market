# Copy this file to .env and adjust it for your machine.
# If .env is missing, XAMPP defaults are used (root with an empty password).

APP_ENV=development
APP_URL=http://127.0.0.1:8091
APP_BASE_PATH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meridian_market
DB_USER=root
DB_PASS=

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BUSINESS_EMAIL=
PAYPAL_CURRENCY=MYR
PAYPAL_API_BASE=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@meridianmarket.test
MAIL_FROM_NAME=Meridian Market
